# This PC's own Pingwin settings (scripts\setup.cmd writes this for you).
# Not synced between PCs, never committed.

# The shared settings folder (config.toml, secrets.env, personas\). Usually a SyncThing folder.
# Leave blank to keep settings in the project folder.
PINGWIN_DATA=C:\Users\YOU\SyncThing\Pingwin

# This PC's name. Must match its entry in the pcs list in config.toml (the order
# there decides which PC answers). Defaults to the computer name if left out.
PINGWIN_NODE=MAIN-PC
