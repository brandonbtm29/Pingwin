# Shared secret: lives in the Pingwin settings folder (synced), never in the code repo.
# Get the token at https://discord.com/developers/applications -> Pingwin -> Bot -> Reset Token.
# Anyone with this token controls the bot. Only share this folder with PCs you trust.
DISCORD_TOKEN=

# Optional: your server's ID, so slash commands appear instantly (overrides guild_id in config.toml).
# PINGWIN_GUILD_ID=

# Optional keys for features. Paste them into the dashboard and it saves them here for you.
# Movie details (Features -> Movie night):
# OMDB_API_KEY=
# Stream alerts:
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YOUTUBE_API_KEY=
# Event attendance rewards:
# UNBELIEVABOAT_TOKEN=
# Sign in with Discord for the online dashboard (Status -> Remote access):
# DISCORD_CLIENT_SECRET=
