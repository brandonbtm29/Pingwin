# Shared secret: lives in the Pingwin settings folder (synced), never in the code repo.
# Get the token at https://discord.com/developers/applications -> Pingwin -> Bot -> Reset Token.
# Anyone with this token controls the bot. Only share this folder with PCs you trust.
DISCORD_TOKEN=

# Optional: your server's ID, so slash commands appear instantly (overrides guild_id in config.toml).
# PINGWIN_GUILD_ID=
